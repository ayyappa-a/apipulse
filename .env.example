# APIPulse Environment Configuration Template
# ============================================================
# Copy this file to .env for local development.
# NEVER commit a .env file with real credentials to source control.
#
# LOCAL DEVELOPMENT ONLY — These credentials are non-production
# and are intended exclusively for the self-contained Docker
# Compose development environment.
# ============================================================

# ── PostgreSQL / TimescaleDB ─────────────────────────────────
# These three variables initialize the Compose TimescaleDB container on first boot.
# All three MUST match the credentials in DATABASE_URL below.
POSTGRES_DB=apipulse
POSTGRES_USER=apipulse
POSTGRES_PASSWORD=apipulse_local_dev

# Full connection URL used by the APIPulse API container inside Compose.
# Uses the Docker service hostname "timescaledb" — NOT localhost.
# For direct local `go run ./cmd/api`, override to: postgres://apipulse:apipulse_local_dev@localhost:5433/apipulse?sslmode=disable
DATABASE_URL=postgres://apipulse:apipulse_local_dev@timescaledb:5432/apipulse?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────
# Uses Docker service hostname "redis" inside Compose.
# For direct local `go run ./cmd/api`, override to: redis://localhost:6379
REDIS_URL=redis://redis:6379

# ── APIPulse API ──────────────────────────────────────────────
APIPULSE_ENV=development
APIPULSE_HTTP_ADDR=:8080
PROMETHEUS_ADDR=:9090
APIPULSE_STORAGE=postgres
APIPULSE_HEALTH_EVALUATION_INTERVAL=5s
APIPULSE_HEALTH_TARGETS=stripe-like:stripe:ap-south-1,stripe-like:stripe:us-east-1
APIPULSE_SHUTDOWN_TIMEOUT_SECONDS=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# Vendor mock URL (internal Docker network hostname)
VENDOR_MOCK_URL=http://vendor-mock:9001

# ── OpenTelemetry (APIPulse's own internal telemetry) ─────────
# Leave empty to disable in development.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=apipulse-gateway

# ── Frontend (Vite dev server) ────────────────────────────────
VITE_APIPULSE_API_URL=http://localhost:8080
# IMPORTANT: Set to false when running against the live backend.
# Only set to true when running frontend in isolation without a backend.
VITE_ENABLE_MOCK_SERVICES=false

# ── Notifications (Phase 4 — leave empty) ─────────────────────
# NEVER commit real values here.
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
